# Note: Copy these variables in your .env file

# DATABASE_URL=file:./dev.db

# If you are running it on a remote server/homelab, you must update timezone otherwise activities times may shift
TZ=America/Edmonton

# For homelab server, change the following to your server ip ex: http://192.168.x.x:3737
NEXTAUTH_URL=http://localhost:3737

# Required when the app is not served from localhost (homelab ip, reverse proxy)
AUTH_TRUST_HOST=true

# AUTH_SECRET is auto-generated by deploy.sh and docker-entrypoint.sh
# To set manually, uncomment and provide your own value:
# AUTH_SECRET=

# ENCRYPTION_KEY is used to encrypt stored API keys (OpenAI, DeepSeek, etc.)
# Must be stable across restarts — changing it will make all stored API keys unrecoverable
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

OPENAI_API_KEY=your-openai-api-key-here

# DeepSeek API Key - get from https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Google Gemini API Key - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API Key - get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# For homelab server, if you ollama is running on server, change the following to your ollamma ip ex: http://192.168.x.x:12345
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI Configuration
# The system uses LLM-based semantic extraction for intelligent, context-aware skill matching
# No configuration needed - semantic extraction is the default

# SkillKlan cabinet login (one-time code). Without these nobody can sign in —
# fail closed. The secret is the backend's JOBSYNC_API_SECRET.
SKILLKLAN_API_URL=https://api.skillklan.com.ua
JOBSYNC_API_SECRET=
CABINET_URL=https://app.skillklan.com.ua
# SkillKlan admin pages: the backend reads per-person numbers from
# /skillklan/admin/stats with this secret (header X-Jobsync-Admin-Secret).
# A different secret from JOBSYNC_API_SECRET; unset or shorter than 32
# characters — the machine API answers 503. Same value as the backend's
# JOBSYNC_ADMIN_API_SECRET.
JOBSYNC_ADMIN_API_SECRET=
# Local development / Playwright only: upstream email + password sign-in and
# sign-up. Ignored in a production build.
# JOBSYNC_DEV_PASSWORD_LOGIN=1

# SkillKlan: the interview recordings library — the «Співбесіди» page,
# listening only, no download. Read-only: a Google service account the QA and BA
# interview folders are shared with (Viewer); its JSON key as is or in base64. The folder ids are the
# bot's upload folders, GOOGLE_DRIVE_FOLDER_ID_{HR,TECH,MANAGER,BA_RECRUITER,BA_TECH,BA_MANAGER}:
# the library is everything under their parents except these folders (not reviewed yet).
# Unset → «Співбесіди» says the recordings are not connected yet.
# INTERVIEW_RECORDINGS_SERVICE_ACCOUNT_JSON=
# INTERVIEW_RECORDINGS_FOLDER_QA_RECRUITER=
# INTERVIEW_RECORDINGS_FOLDER_QA_TECH=
# INTERVIEW_RECORDINGS_FOLDER_QA_MANAGER=
# INTERVIEW_RECORDINGS_FOLDER_BA_RECRUITER=
# INTERVIEW_RECORDINGS_FOLDER_BA_TECH=
# INTERVIEW_RECORDINGS_FOLDER_BA_MANAGER=

# Observability (OTel traces + logs to a self-hosted OpenObserve instance)
# Off by default — leave all four commented out for no change in behaviour.
# Base URL only; the app appends /v1/traces and /v1/logs itself
# OTEL_EXPORTER_OTLP_ENDPOINT=http://homelab:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64(email:token)
# OTEL_SERVICE_NAME=jobsync
# Also captures prompt/response content on LLM spans — has no effect unless OTEL_EXPORTER_OTLP_ENDPOINT above is also set
# OTEL_CAPTURE_CONTENT=false
