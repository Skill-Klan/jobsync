# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/evals/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
*.env*
!.env.example

# vercel
.vercel

# local scripts
release.sh

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite databases (prisma dev + docker volume), incl. WAL sidecars
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# local user data: uploaded resumes and the docker sqlite bind mount
/data/
/jobsyncdb/

/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.github/*
!.github/workflows
!.github/CODEOWNERS
# Agent instructions are shared (CLAUDE.md, .claude/rules/, .claude/settings.json); everything else in
# .claude/ — agent worktrees, personal notes, settings.local.json — stays local. `!.claude/` re-includes
# the folder over a global ignore of it.
!.claude/
.claude/*
!.claude/rules/
!.claude/settings.json
CLAUDE.local.md
.specify
/specs
.vscode
AGENTS.md
.promptfoo/

# Generated by evals/agent-chat/generate-tools.ts
evals/agent-chat/tools.json

# One-off eval investigation harnesses. Kept on disk so a finding can be
# re-run, but not part of the shipped suite. See the runs they produced in
# docs/architecture/agent-chat.md.
evals/*/_investigate-*
